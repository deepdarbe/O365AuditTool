{
  "ConnectionStrings": {
    "AuditDb": "Data Source=./data/audit.db"
  },
  "Auth": {
    "RoleMappings": {
      "AuditAdmin": [ "DOMAIN\\GG_O365_Audit_Admin" ],
      "AuditReader": [ "DOMAIN\\GG_O365_Audit_Read" ],
      "MigrationPlanner": [ "DOMAIN\\GG_O365_Migration_Planner" ]
    }
  },
  "Collector": {
    "PsExecPath": "C:\\Tools\\PsExec\\psexec.exe",
    "RemoteScriptPath": "\\\\filesrv\\audit\\collector.ps1",
    "RemoteTempJsonPath": "C:\\Windows\\Temp\\o365-audit.json",
    "DeviceTimeoutSeconds": 300,
    "MaxDeviceParallelism": 4,
    "JobPollingSeconds": 10,
    "DailyRunHour": 2,
    "DailyRunMinute": 15,
    "RetryMinutes": [ 30, 120, 1440 ],
    "FallbackTargets": [],
    "DefaultOuFilter": ""
  },
  "Copy": {
    "Enabled": false,
    "DefaultTargetRoot": "",
    "AllowedTargetRoots": [],
    "MaxParallelism": 2,
    "BufferSizeMb": 4,
    "VerifySha256": false,
    "MaxAttempts": 2,
    "PollingSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
